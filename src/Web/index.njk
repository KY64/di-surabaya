<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panduan Surabaya Terkini | Transportasi, Darurat, & Info Kota</title>
    
    <meta name="description" content="Panduan singkat untuk Kota Surabaya, berisi informasi terkini tentang rute Suroboyo Bus, Feeder Wirawiri Suroboyo, Kereta Komuter, kontak darurat 112, 118, dan layanan publik lainnya.">
    <meta name="keywords" content="Surabaya, Panduan Kota, Transportasi Surabaya, Suroboyo Bus, Feeder Surabaya, Wirawiri Surabaya, Kereta Komuter, Nomor Darurat Surabaya, Akun Layanan Publik Surabaya">
    <meta property="og:title" content="Di Surabaya - Panduan Kota Pahlawan">
    <meta property="og:description" content="Informasi penting dan cepat tentang transportasi dan layanan darurat di Surabaya.">
    <meta property="og:type" content="website">
    
    <link rel="icon" href="assets/logo.svg" type="image/svg+xml">
    <link rel="alternate icon" href="favicon.ico" sizes="any">

    <link rel="preload" href="styles.css" as="style">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" media="print" onload="this.media='all'">
    
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <div class="container">
        
        <header class="site-header">
            <div class="logo">
                <h1>di<br>surabaya.</h1>
                <p>Panduan Kota Pahlawan</p>
            </div>
            <a href="#transportasi-surabaya" class="masthead-logo" aria-label="Kembali ke direktori panduan kota">
                <img src="assets/logo.svg" alt="Logo di Surabaya" class="site-logo" width="148" height="120">
            </a>
        </header>

        <main class="main-content">

            <section class="section" id="transportasi-surabaya">
                <div class="section-header">
                    <h2 class="section-title">Transportasi</h2>
                    <span class="section-tag">PUB</span>
                </div>
                
                <div class="transport-list" id="transportList">
                  <a href="https://drive.google.com/file/d/{{BUS_MAP_FILE_ID}}/view" target="_blank" rel="noopener" class="transport-card search-item">
                        <div class="transport-content">
                            <div>
                                <h3 class="transport-title">Suroboyo Bus & Feeder</h3>
                                <p class="transport-desc">Rute Bus, Feeder WiraWiri, & Halte</p>
                            </div>
                            <div class="transport-action">
                                <span class="badge-outline">MAPS</span>
                                <i class="fa-solid fa-arrow-right arrow-icon"></i>
                            </div>
                        </div>
                    </a>

                    <a href="https://drive.google.com/file/d/{{TRAIN_MAP_FILE_ID}}/view" target="_blank" rel="noopener" class="transport-card search-item">
                        <div class="transport-content">
                            <div>
                                <h3 class="transport-title">Kereta Komuter</h3>
                                <p class="transport-desc">Rute Kereta Komuter</p>
                            </div>
                            <div class="transport-action">
                                <span class="badge-outline">MAPS</span>
                                <i class="fa-solid fa-arrow-right arrow-icon"></i>
                            </div>
                        </div>
                    </a>
                </div>
            </section>

            <section class="section" id="nomor-darurat-surabaya">
                <div class="section-header">
                    <h2 class="section-title">Darurat</h2>
                    <span class="section-tag accent">SOS</span>
                </div>

                <div class="emergency-grid" id="emergencyList">
                  {% for contact in data.contacts %}
                    {% if contact.category == "emergency" %}
                    <a href="tel:{{ contact.number }}" role="button" class="emergency-card-link">
                      <div class="grid-item search-item sos-{{ contact.style }}" title="Nomor Darurat {{ contact.name }}">
                        <div>
                          <div class="sos-number">{{ contact.number }}</div>
                          <div class="sos-label">{{ contact.label }}</div>
                        </div>
                        <span class="emergency-symbol" aria-hidden="true">◎</span>
                      </div>
                    </a>
                    {% endif %}
                  {% endfor %}
                </div>

                <div class="emergency-links">
                    <a href="https://surabaya.go.id" class="link-card search-item" title="Pemerintah Kota Surabaya" target="_blank" rel="noopener">
                        <span class="service-arrow" aria-hidden="true">↗</span>
                        <span class="link-text">Pemerintah Kota Surabaya</span>
                    </a>
                    <a href="https://mediacenter.surabaya.go.id" class="link-card search-item" title="Layanan Pengaduan" target="_blank" rel="noopener">
                        <span class="service-arrow" aria-hidden="true">↗</span>
                        <span class="link-text">Layanan Pengaduan</span>
                    </a>
                    <a href="https://wbs.surabaya.go.id" class="link-card search-item" title="Whistleblowing System Surabaya" target="_blank" rel="noopener">
                        <span class="service-arrow" aria-hidden="true">↗</span>
                        <span class="link-text">Whistleblowing System</span>
                    </a>
                    <a href="https://linktr.ee/tfsurabaya" class="link-card search-item" title="Transportation for Surabaya (community)" target="_blank" rel="noopener">
                        <span class="service-arrow" aria-hidden="true">↗</span>
                        <span class="link-text">Transportation for Surabaya</span>
                    </a>
                    <a href="https://www.suarasurabaya.net" class="link-card search-item" title="Radio Berita Surabaya" target="_blank" rel="noopener">
                        <span class="service-arrow" aria-hidden="true">↗</span>
                        <span class="link-text">Radio Berita Surabaya</span>
                    </a>
                    <a href="https://tourism.surabaya.go.id" class="link-card search-item" title="Turisme Surabaya" target="_blank" rel="noopener">
                        <span class="service-arrow" aria-hidden="true">↗</span>
                        <span class="link-text">Turisme Surabaya</span>
                    </a>
                </div>
            </section>

            <section class="section" id="akun-resmi-surabaya">
                 <div class="section-header">
                    <h2 class="section-title">Akun Resmi</h2>
                    <span class="section-tag">NET</span>
                </div>
                
                <nav class="social-container" id="socialList" aria-label="Akun Instagram resmi">
                    <a href="https://instagram.com/tourism.surabaya/" target="_blank" rel="noopener" class="social-link search-item" title="Instagram Resmi Turisme di Surabaya">
                        @tourism.surabaya
                    </a>
                    <a href="https://instagram.com/surabaya/" target="_blank" rel="noopener" class="social-link search-item" title="Instagram Resmi Pemerintah Kota Surabaya">
                        @surabaya
                    </a>
                    <a href="https://instagram.com/sapawargasby/" target="_blank" rel="noopener" class="social-link search-item" title="Instagram Resmi Sapa Warga Surabaya">
                        @sapawargasby
                    </a>
                    <a href="https://instagram.com/dishubsurabaya/" target="_blank" rel="noopener" class="social-link search-item" title="Instagram Resmi Dinas Perhubungan Surabaya">
                        @dishubsurabaya
                    </a>
                </nav>
            </section>

        </main>

        <footer class="footer">
            <div class="footer-brand">Surabaya, Indonesia.</div>
            <a href="https://github.com/KY64/di-surabaya" target="_blank" rel="noopener" class="footer-github" aria-label="Buka repositori GitHub di-surabaya">
                <i class="fa-brands fa-github" style="font-size: 14pt" aria-hidden="true"></i>
                <span>Source</span>
            </a>
            <div class="footer-copy">&copy; 2026 / Data Publik</div>
        </footer>

    </div>

</body>
</html>
